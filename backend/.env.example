# Copy this file to .env and fill in real values. Never commit .env.

# Port the API server listens on
PORT=5001

# MongoDB connection string
# Local example:  mongodb://127.0.0.1:27017/job_application_platform
# Atlas example:  mongodb+srv://<username>:<password>@<cluster-host>/job_application_platform
MONGODB_URI=mongodb://127.0.0.1:27017/job_application_platform

# Explicit database selection (overrides any database in the URI)
MONGODB_DB_NAME=job_application_platform

# Browser origin allowed to read API responses
FRONTEND_ORIGIN=http://localhost:5173

# Secret for signing login tokens (JWT). Required; at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Never commit the real value. The placeholder below is deliberately too short,
# so the server refuses to start until you replace it.
JWT_SECRET=change-me

# Optional: HTTP request logging (Morgan "dev" format). Leave unset for the
# default: on for npm start / npm run dev, off for automated tests.
# Set to true or false to override.
# HTTP_LOGGING=true
